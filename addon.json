{
  "id": "registrar-enom",
  "name": "eNom",
  "version": "0.1.0",
  "kind": "registrar",
  "engine": "wasm",
  "provides": "enom",
  "abi": "0.2.0",
  "wasm": "addon.wasm",
  "description": "addons.desc.registrar.enom",
  "author": "MythicalSystems",
  "permissions": [
    "domains.manage",
    "network.outbound"
  ],
  "capabilities": {
    "http": [
      "reseller.enom.com",
      "resellertest.enom.com",
      "$setting:api_base"
    ],
    "secrets": []
  },
  "settings": [
    {
      "key": "uid",
      "label": "addons.registrar.setting.uid",
      "kind": "text",
      "required": true
    },
    {
      "key": "password",
      "label": "addons.registrar.setting.password",
      "kind": "secret",
      "required": true
    },
    {
      "key": "test_mode",
      "label": "addons.registrar.setting.test_mode",
      "kind": "bool",
      "required": false,
      "default": false
    },
    {
      "key": "api_base",
      "label": "addons.registrar.setting.api_base",
      "kind": "text",
      "required": false
    }
  ]
}
